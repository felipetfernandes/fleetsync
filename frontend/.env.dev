# URL da API do Backend para o ambiente de desenvolvimento
# O frontend (rodando no navegador do host ou dentro do container) 
# precisa acessar o backend. 
# Se acessado do host: http://localhost:3001/api (se a porta 3001 estiver exposta)
# Se acessado de dentro do container (SSR ou build time): http://backend_dev:3001/api
# Vamos usar localhost assumindo que o acesso principal será do navegador no host.
#NEXT_PUBLIC_API_URL=http://localhost:3001/

NEXT_PUBLIC_LOCAL_API_URL=http://localhost:3001/api
NEXT_PUBLIC_DOCKER_API_URL=http://backend:3001/api
