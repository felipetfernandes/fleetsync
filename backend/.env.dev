# Ambiente
NODE_ENV=development
PORT=3001

# Database - MySQL (Development - Docker Compose Service)
# Use variáveis de ambiente ou secrets para senhas em cenários reais.
MYSQL_ROOT_PASSWORD=root 
MYSQL_DATABASE=gestordefrota

DATABASE_URL="mysql://root:root@mysql_dev:3306/gestordefrota" # Nome do serviço definido em docker-compose.dev.yml

# JWT
# Use um segredo diferente e mais fraco para desenvolvimento.
JWT_SECRET=sua_chave_secreta_muito_segura_para_jwt 
JWT_EXPIRATION=1d

